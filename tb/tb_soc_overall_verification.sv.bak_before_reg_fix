            axi_write(32'h4000_4000, 32'h0000_0000, 4'b1111, ok); // CTRL = 0
            axi_write(32'h4000_400C, 32'd2,         4'b1111, ok); // PRE = 2
            axi_write(32'h4000_4004, 32'd500,       4'b1111, ok); // LOAD = 500
            // Start timer: en=1, auto_reload=1, pre_en=1 -> CTRL = 0x07
            axi_write(32'h4000_4000, 32'h0000_0007, 4'b1111, ok);

