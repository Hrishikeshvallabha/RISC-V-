// ============================================================================
// File: tb_soc_overall_verification.sv
// Project: RISC-V-Based SoC for Smart Temperature Monitoring and Fan Control
//
// Authoritative Overall SoC SystemVerilog Testbench for Complete Regression:
//   - VeeR EL2 RISC-V Processor (RV32IMC + Zicsr, 64-to-32 Adapters, 2-to-1 Arbiter)
//   - 2-Master x 8-Slave AXI4 Crossbar Interconnect (axi_interconnect_wrap_2x8)
//   - 64 KiB Unified Memory Subsystem (0x0000_0000 - 0x0000_FFFF)
//   - 6 Memory-Mapped Peripheral Subsystems:
//       M01: UART (0x4000_0000)
//       M02: GPIO (0x4000_2000)
//       M03: Timer (0x4000_4000)
//       M04: SPI Temperature Sensor Master (0x4000_6000)
//       M05: PWM Fan Speed Controller (0x4000_A000)
//       M06: 7-Segment Multiplexed Display Controller (0x4000_C000)
//       M07: Unmapped / Reserved Slave Protection Region
//
// Complete Test Suite (Traceable to doc/SoC_Verification_Test_Cases.xlsx):
//   TC-01 : RISC-V VeeR EL2 CPU Boot, Cold Reset & Memory Fetch Bring-Up
//   TC-02 : Unified Memory 32-Bit/Byte-Lane R/W Integrity & Stack Allocation
//   TC-03 : AXI4 Crossbar Slave Address Decoding & Bus Routing (M00-M06)
//   TC-04 : Reserved Buffer Region Isolation & Unmapped Slave M07 Protection
//   TC-05 : Core IFU/LSU Master Arbitration & Dual-Master Crossbar Concurrency
//   TC-06 : UART Line Control, Baud Rate Divisor & Transmitter Telemetry Operation
//   TC-07 : UART Receiver Frame Capture, Glitch Filter & Status Flag Tracking
//   TC-08 : GPIO Direction Configuration, Output Driving & Input Pin Sampling
//   TC-09 : GPIO Atomic Bit Manipulation (SET, CLEAR) & Error Flag Control
//   TC-10 : Hardware Timer Prescaler, Downward Decrement & Auto-Reload
//   TC-11 : Hardware Timer Compare Match & Interrupt Generation
//   TC-12 : SPI Master Controller Initialization, Mode 0 Clock & Manual Chip-Select
//   TC-13 : SPI Full-Duplex Sensor Byte Exchange & FIFO Status Tracking
//   TC-14 : PWM Fan Controller Duty Cycle Programming & Physical Waveform Modulation
//   TC-15 : Seven-Segment Display Packed BCD Data, Enable & Multiplexed Anode Scanning
//   TC-16 : Multi-Tier Autonomous Thermal Policy & Dynamic Fan Speed Regulation
//   TC-17 : End-to-End Real-Time Telemetry Streaming & Console Diagnostic Formatting
//   TC-18 : Sensor Communication Timeout, Out-of-Bounds Detection & Fail-Safe Emergency Cooling
// ============================================================================

`timescale 1ns / 1ps

module tb_soc_overall_verification;

    // -----------------------------------------------------------------------
    // Simulation Parameters
    // -----------------------------------------------------------------------
    localparam time CLK_PERIOD              = 10ns; // 100 MHz system clock
    localparam integer DATA_WIDTH           = 32;
    localparam integer ADDR_WIDTH           = 32;
    localparam integer IC_ID_WIDTH          = 8;
    localparam integer STRB_WIDTH           = 4;
    localparam integer GPIO_NUM_BITS        = 32;
    localparam integer SEVEN_SEG_REFRESH_DIV= 10;   // Accelerated refresh for sim
    localparam integer UART_DIVISOR         = 4;    // 50 ns bit period in simulation
    localparam time    UART_BIT_PERIOD      = 50ns; // 5 clock cycles at 100 MHz

    // -----------------------------------------------------------------------
    // Clock and Reset Signals
    // -----------------------------------------------------------------------
    logic clk;
    logic rst;          // Active-high system reset
    logic core_rst_n_i; // Active-high core run enable (active-low core reset)

    // -----------------------------------------------------------------------
    // External Test Master Interface (AXI4 Slave S00 on Crossbar)
    // -----------------------------------------------------------------------
    logic [IC_ID_WIDTH-1:0]  axi_awid;
    logic [ADDR_WIDTH-1:0]   axi_awaddr;
    logic [7:0]              axi_awlen;
    logic [2:0]              axi_awsize;
    logic [1:0]              axi_awburst;
    logic                    axi_awlock;
    logic [3:0]              axi_awcache;
    logic [2:0]              axi_awprot;
    logic [3:0]              axi_awqos;
    logic                    axi_awvalid;
    wire                     axi_awready;

    logic [DATA_WIDTH-1:0]   axi_wdata;
    logic [STRB_WIDTH-1:0]   axi_wstrb;
    logic                    axi_wlast;
    logic                    axi_wvalid;
    wire                     axi_wready;

    wire  [IC_ID_WIDTH-1:0]  axi_bid;
    wire  [1:0]              axi_bresp;
    wire                     axi_bvalid;
    logic                    axi_bready;

    logic [IC_ID_WIDTH-1:0]  axi_arid;
    logic [ADDR_WIDTH-1:0]   axi_araddr;
    logic [7:0]              axi_arlen;
    logic [2:0]              axi_arsize;
    logic [1:0]              axi_arburst;
    logic                    axi_arlock;
    logic [3:0]              axi_arcache;
    logic [2:0]              axi_arprot;
    logic [3:0]              axi_arqos;
    logic                    axi_arvalid;
    wire                     axi_arready;

    wire  [IC_ID_WIDTH-1:0]  axi_rid;
    wire  [DATA_WIDTH-1:0]   axi_rdata;
    wire  [1:0]              axi_rresp;
    wire                     axi_rlast;
    wire                     axi_rvalid;
    logic                    axi_rready;

    // -----------------------------------------------------------------------
    // Peripheral External Signals
    // -----------------------------------------------------------------------
    // UART
    logic                    uart_rx_i;
    wire                     uart_tx_o;
    wire                     uart_interrupt_o;

    // SPI (Temperature Sensor)
    wire                     spi_clk_o;
    wire                     spi_cs_n_o;
    wire                     spi_mosi_o;
    logic                    spi_miso_i;
    wire                     spi_irq_o;

    // PWM (Fan Controller)
    wire                     pwm_out_o;
    wire                     pwm_irq_o;

    // Seven-Segment Display
    wire  [6:0]              seg;
    wire  [3:0]              an;

    // GPIO (Bidirectional)
    wire  [GPIO_NUM_BITS-1:0] gpio_io;
    wire                     gpio_intr_o;
    logic [GPIO_NUM_BITS-1:0] gpio_tb_drive;
    logic [GPIO_NUM_BITS-1:0] gpio_tb_dir;

    genvar gi;
    generate
        for (gi = 0; gi < GPIO_NUM_BITS; gi = gi + 1) begin : gen_gpio_io
            assign gpio_io[gi] = gpio_tb_dir[gi] ? gpio_tb_drive[gi] : 1'bz;
        end
    endgenerate

    // Timer
    logic                    timer_ext_meas_i;
    logic                    timer_capture_i;
    wire                     timer_pwm_o;
    wire                     timer_trigger_o;
    wire                     timer_irq_o;

    // VeeR EL2 Core Pipeline Trace Signals
    wire  [31:0]             trace_rv_i_insn_ip;
    wire  [31:0]             trace_rv_i_address_ip;
    wire                     trace_rv_i_valid_ip;
    wire                     trace_rv_i_exception_ip;
    wire  [4:0]              trace_rv_i_ecause_ip;
    wire                     trace_rv_i_interrupt_ip;
    wire  [31:0]             trace_rv_i_tval_ip;

    // -----------------------------------------------------------------------
    // Verdi Waveform-Visible Diagnostic Signals & Test Markers
    // -----------------------------------------------------------------------
    integer          test_id             = 0;          // Current test ID (1..18)
    reg [255:0]      test_name           = "IDLE";     // Active test name string
    reg [63:0]       test_state          = "IDLE";     // "START", "RUNNING", "PASS", "FAIL", "BLOCKED"
    logic [1:0]      test_status         = 2'b00;      // 00=RUNNING, 01=PASS, 10=FAIL, 11=BLOCKED
    logic            test_start_marker   = 1'b0;       // Asserted at test start
    logic            test_done_marker    = 1'b0;       // Asserted at test completion
    time             test_start_time     = 0;
    time             test_end_time       = 0;

    // C Firmware Mailbox Status Signals (Live Verdi Co-Simulation)
    integer          fw_test_id          = 0;          // C Firmware Test ID (1..18)
    reg [63:0]       fw_test_state       = "IDLE";     // "IDLE", "RUNNING", "PASS", "FAIL"
    logic [1:0]      fw_test_status      = 2'b00;      // 00=RUNNING, 01=PASS, 10=FAIL, 11=BLOCKED
    logic            fw_start_marker     = 1'b0;
    logic            fw_done_marker      = 1'b0;
    reg [63:0]       overall_test_state  = "IDLE";

    // Runtime Test Selection & Waveform Target
    integer          target_test_id      = 0;          // 0 = Full regression, 1..18 = Individual test
    string           fsdb_file           = "soc_overall_regression.fsdb";

    // Test Case Result Tracking Tables (1..18)
    logic [1:0]      tc_c_status_table      [1:18];    // 00=NOT RUN, 01=PASS, 10=FAIL, 11=BLOCKED/NA
    logic [1:0]      tc_sv_status_table     [1:18];
    logic [1:0]      tc_overall_status_table[1:18];
    time             tc_start_table         [1:18];
    time             tc_end_table           [1:18];
    string           tc_name_table          [1:18];
    string           tc_expected_table      [1:18];
    string           tc_actual_table        [1:18];
    string           tc_check_table         [1:18];
    string           tc_evidence_table      [1:18];
    string           tc_remarks_table       [1:18];

    // Global Regression Counters
    integer test_pass_count    = 0;
    integer test_fail_count    = 0;
    integer test_blocked_count = 0;
    integer total_tests_run    = 0;

    // Pipeline & Application Execution Counters
    integer instructions_retired   = 0;
    integer uart_chars_decoded     = 0;
    integer spi_transactions_count = 0;
    bit     firmware_halted        = 1'b0;
    bit     firmware_loaded_ok     = 1'b0;
    bit     cpu_saw_main           = 1'b0;

    // S01 Controlled Master Driver Signals (Static nets for force statements)
    logic [7:0]  s01_drv_awid;
    logic [31:0] s01_drv_awaddr;
    logic [31:0] s01_drv_wdata;
    logic [3:0]  s01_drv_wstrb;
    logic        s01_drv_awvalid;
    logic        s01_drv_wvalid;
    logic        s01_drv_bready;
    logic [7:0]  s01_drv_arid;
    logic [31:0] s01_drv_araddr;
    logic        s01_drv_arvalid;
    logic        s01_drv_rready;

    // -----------------------------------------------------------------------
    // Device Under Test (DUT) Instantiation
    // -----------------------------------------------------------------------
    soc_veer_el2_temperature_fan_top #(
        .DATA_WIDTH            (DATA_WIDTH),
        .ADDR_WIDTH            (ADDR_WIDTH),
        .IC_ID_WIDTH           (IC_ID_WIDTH),
        .GPIO_NUM_BITS         (GPIO_NUM_BITS),
        .SEVEN_SEG_REFRESH_DIV (SEVEN_SEG_REFRESH_DIV)
    ) dut (
        .clk                    (clk),
        .rst                    (rst),
        .core_rst_n_i           (core_rst_n_i),

        .axi_awid               (axi_awid),
        .axi_awaddr             (axi_awaddr),
        .axi_awlen              (axi_awlen),
        .axi_awsize             (axi_awsize),
        .axi_awburst            (axi_awburst),
        .axi_awlock             (axi_awlock),
        .axi_awcache            (axi_awcache),
        .axi_awprot             (axi_awprot),
        .axi_awqos              (axi_awqos),
        .axi_awvalid            (axi_awvalid),
        .axi_awready            (axi_awready),

        .axi_wdata              (axi_wdata),
        .axi_wstrb              (axi_wstrb),
        .axi_wlast              (axi_wlast),
        .axi_wvalid             (axi_wvalid),
        .axi_wready             (axi_wready),

        .axi_bid                (axi_bid),
        .axi_bresp              (axi_bresp),
        .axi_bvalid             (axi_bvalid),
        .axi_bready             (axi_bready),

        .axi_arid               (axi_arid),
        .axi_araddr             (axi_araddr),
        .axi_arlen              (axi_arlen),
        .axi_arsize             (axi_arsize),
        .axi_arburst            (axi_arburst),
        .axi_arlock             (axi_arlock),
        .axi_arcache            (axi_arcache),
        .axi_arprot             (axi_arprot),
        .axi_arqos              (axi_arqos),
        .axi_arvalid            (axi_arvalid),
        .axi_arready            (axi_arready),

        .axi_rid                (axi_rid),
        .axi_rdata              (axi_rdata),
        .axi_rresp              (axi_rresp),
        .axi_rlast              (axi_rlast),
        .axi_rvalid             (axi_rvalid),
        .axi_rready             (axi_rready),

        .uart_rx_i              (uart_rx_i),
        .uart_tx_o              (uart_tx_o),
        .uart_interrupt_o       (uart_interrupt_o),

        .spi_clk_o              (spi_clk_o),
        .spi_cs_n_o             (spi_cs_n_o),
        .spi_mosi_o             (spi_mosi_o),
        .spi_miso_i             (spi_miso_i),
        .spi_irq_o              (spi_irq_o),

        .pwm_out_o              (pwm_out_o),
        .pwm_irq_o              (pwm_irq_o),

        .seg                    (seg),
        .an                     (an),

        .gpio_io                (gpio_io),
        .gpio_intr_o            (gpio_intr_o),

        .timer_ext_meas_i       (timer_ext_meas_i),
        .timer_capture_i        (timer_capture_i),
        .timer_pwm_o            (timer_pwm_o),
        .timer_trigger_o        (timer_trigger_o),
        .timer_irq_o            (timer_irq_o),

        .trace_rv_i_insn_ip     (trace_rv_i_insn_ip),
        .trace_rv_i_address_ip  (trace_rv_i_address_ip),
        .trace_rv_i_valid_ip    (trace_rv_i_valid_ip),
        .trace_rv_i_exception_ip(trace_rv_i_exception_ip),
        .trace_rv_i_ecause_ip   (trace_rv_i_ecause_ip),
        .trace_rv_i_interrupt_ip(trace_rv_i_interrupt_ip),
        .trace_rv_i_tval_ip     (trace_rv_i_tval_ip)
    );

    // -----------------------------------------------------------------------
    // Clock Generation (100 MHz System Clock)
    // -----------------------------------------------------------------------
    initial begin
        clk = 1'b0;
        forever #(CLK_PERIOD / 2) clk = ~clk;
    end

    // -----------------------------------------------------------------------
    // Synopsys Verdi FSDB Waveform Dumping
    // -----------------------------------------------------------------------
    initial begin
        if ($value$plusargs("TARGET_TEST_ID=%d", target_test_id)) begin
            $display("[TEST CONFIG] Runtime TARGET_TEST_ID received: %0d", target_test_id);
        end else if ($value$plusargs("TEST_ID=%d", target_test_id)) begin
            $display("[TEST CONFIG] Runtime TEST_ID received: %0d", target_test_id);
        end else begin
            target_test_id = 0;
        end

        if ($value$plusargs("FSDB_FILE=%s", fsdb_file)) begin
            $display("[FSDB CONFIG] Custom waveform output requested: %s", fsdb_file);
        end else if (target_test_id >= 1 && target_test_id <= 18) begin
            $sformat(fsdb_file, "waves/soc_tc%02d.fsdb", target_test_id);
            $display("[FSDB CONFIG] Single Test Waveform Selected for TC-%02d: %s", target_test_id, fsdb_file);
        end else begin
            fsdb_file = "soc_overall_regression.fsdb";
            $display("[FSDB CONFIG] Full Regression Waveform Selected: %s", fsdb_file);
        end

        $fsdbDumpfile(fsdb_file);
        $fsdbDumpvars(0, tb_soc_overall_verification, "+all");
        $fsdbDumpSVA;
        $fsdbDumpMDA;
    end

    // -----------------------------------------------------------------------
    // Address Map Target Name Decoder
    // -----------------------------------------------------------------------
    function automatic string get_target_name(input logic [31:0] addr);
        if (addr < 32'h0001_0000) return "RAM (M00)";
        if (addr >= 32'h4000_0000 && addr < 32'h4000_1000) return "UART (M01)";
        if (addr >= 32'h4000_2000 && addr < 32'h4000_3000) return "GPIO (M02)";
        if (addr >= 32'h4000_4000 && addr < 32'h4000_5000) return "TIMER (M03)";
        if (addr >= 32'h4000_6000 && addr < 32'h4000_7000) return "SPI (M04)";
        if (addr >= 32'h4000_A000 && addr < 32'h4000_B000) return "PWM (M05)";
        if (addr >= 32'h4000_C000 && addr < 32'h4000_D000) return "7-SEG (M06)";
        return "RESERVED/M07";
    endfunction

    // -----------------------------------------------------------------------
    // AXI Bus Handshake & Transaction Data-Flow Logger
    // [time][Initiator][TC-XX][AXI-WRITE/READ] Address=0x... Target=... Data=... Response=...
    // -----------------------------------------------------------------------
    logic [31:0] s00_awaddr_q = 32'h0;
    logic [31:0] s00_wdata_q  = 32'h0;
    logic [31:0] s00_araddr_q = 32'h0;

    always @(posedge clk) begin
        if (!rst) begin
            // S00 Write Handshake Tracking
            if (axi_awvalid && axi_awready) s00_awaddr_q <= axi_awaddr;
            if (axi_wvalid && axi_wready)   s00_wdata_q  <= axi_wdata;

            if (axi_bvalid && axi_bready) begin
                $display("  [%0t ps][S00-TB][TC-%02d][AXI-WRITE] Address=0x%08h Target=%-12s Data=0x%08h WSTRB=0x%01h BRESP=2'b%02b",
                         $time, test_id, s00_awaddr_q, get_target_name(s00_awaddr_q), s00_wdata_q, axi_wstrb, axi_bresp);
            end

            // S00 Read Handshake Tracking
            if (axi_arvalid && axi_arready) s00_araddr_q <= axi_araddr;

            if (axi_rvalid && axi_rready) begin
                $display("  [%0t ps][S00-TB][TC-%02d][AXI-READ]  Address=0x%08h Target=%-12s Data=0x%08h RRESP=2'b%02b",
                         $time, test_id, s00_araddr_q, get_target_name(s00_araddr_q), axi_rdata, axi_rresp);
            end

            // S01 Core Master Transaction Logging (Sampled when active)
            if (dut.s01_bvalid && dut.s01_bready && (dut.s01_awaddr != 32'h0)) begin
                $display("  [%0t ps][CPU-LSU][TC-%02d][AXI-WRITE] Address=0x%08h Target=%-12s Data=0x%08h BRESP=2'b%02b",
                         $time, test_id, dut.s01_awaddr, get_target_name(dut.s01_awaddr), dut.s01_wdata, dut.s01_bresp);
            end
            if (dut.s01_rvalid && dut.s01_rready && (dut.s01_araddr >= 32'h4000_0000)) begin
                $display("  [%0t ps][CPU-LSU][TC-%02d][AXI-READ]  Address=0x%08h Target=%-12s Data=0x%08h RRESP=2'b%02b",
                         $time, test_id, dut.s01_araddr, get_target_name(dut.s01_araddr), dut.s01_rdata, dut.s01_rresp);
            end
        end
    end

    // -----------------------------------------------------------------------
    // VeeR EL2 Pipeline Trace & Execution Monitor
    // -----------------------------------------------------------------------
    always @(posedge clk) begin
        if (trace_rv_i_valid_ip) begin
            instructions_retired = instructions_retired + 1;

            if (instructions_retired <= 25 || (instructions_retired >= 1000 && instructions_retired <= 1010)) begin
                $display("  [VeeR TRACE #%0d] PC=0x%08h INSN=0x%08h", instructions_retired, trace_rv_i_address_ip, trace_rv_i_insn_ip);
            end

            // Detect main() entry point at 0x0000_08BE
            if (trace_rv_i_address_ip == 32'h0000_08BE && !cpu_saw_main) begin
                cpu_saw_main = 1'b1;
                $display("\n[VeeR MONITOR @ %0t ps] Core reached main() entry point at PC=0x%08h! (Retired %0d insns)", 
                         $time, trace_rv_i_address_ip, instructions_retired);
            end

            // Detect graceful halt loop (wfi at 0x0000_003A or 0x0000_003E)
            if (trace_rv_i_address_ip == 32'h0000_003A || trace_rv_i_address_ip == 32'h0000_003E) begin
                if (!firmware_halted) begin
                    firmware_halted = 1'b1;
                    $display("\n[VeeR MONITOR @ %0t ps] VeeR EL2 core entered halt loop (WFI at PC=0x%08h)!", 
                             $time, trace_rv_i_address_ip);
                end
            end
        end

        if (trace_rv_i_exception_ip) begin
            $display("  [EXCEPTION DETECTED @ %0t ps] PC=0x%08h ecause=%0d tval=0x%08h", 
                     $time, trace_rv_i_address_ip, trace_rv_i_ecause_ip, trace_rv_i_tval_ip);
        end
    end

    // -----------------------------------------------------------------------
    // Dynamic SPI Temperature Sensor Slave Model
    // -----------------------------------------------------------------------
    reg [7:0] sensor_table [0:15];
    reg [7:0] active_sensor_byte;
    integer   sbit_idx;

    initial begin
        sensor_table[0]  = 8'h19; // 25 C (FW-SPI-001 self-test verification)
        sensor_table[1]  = 8'h19; // 25 C (Cycle 1: Normal/Quiet Mode -> Duty 25%, 7Seg 0x25C0)
        sensor_table[2]  = 8'h1E; // 30 C (Cycle 2: Warm Boundary -> Duty 50%, 7Seg 0x30C0)
        sensor_table[3]  = 8'h23; // 35 C (Cycle 3: Warm Operating Range -> Duty 50%, 7Seg 0x35C0)
        sensor_table[4]  = 8'h2D; // 45 C (Cycle 4: Upper Warm Threshold -> Duty 50%, 7Seg 0x45C0)
        sensor_table[5]  = 8'h32; // 50 C (Cycle 5: High Temp Alert -> Boost Duty 85%, 7Seg 0x50C0)
        sensor_table[6]  = 8'h37; // 55 C (Cycle 6: High Temp Alert -> Boost Duty 85%, 7Seg 0x55C0)
        sensor_table[7]  = 8'h3C; // 60 C (Cycle 7: Thermal Dissipation -> Boost Duty 85%, 7Seg 0x60C0)
        sensor_table[8]  = 8'h82; // 130 C (Cycle 8: Emergency Out-of-Bounds -> 100% Fail-Safe, 7Seg 0xEEEE)
        sensor_table[9]  = 8'h19; // 25 C (Cycle 9: Cooldown Recovery -> Duty 25%, 7Seg 0x25C0)
        sensor_table[10] = 8'h16; // 22 C (Cycle 10: Steady-State Ambient -> Duty 25%, 7Seg 0x22C0)
        sensor_table[11] = 8'h19;
        sensor_table[12] = 8'h19;
        sensor_table[13] = 8'h19;
        sensor_table[14] = 8'h19;
        sensor_table[15] = 8'h19;
    end

    always @(negedge spi_cs_n_o) begin
        if (!rst) begin
            if (spi_transactions_count < 16) begin
                active_sensor_byte = sensor_table[spi_transactions_count];
            end else begin
                active_sensor_byte = 8'h19;
            end
            spi_transactions_count = spi_transactions_count + 1;

            $display("  [SPI SENSOR MODEL @ %0t ps] CS active low! Transaction #%0d: Providing temp byte 0x%02h (%0d C)",
                     $time, spi_transactions_count, active_sensor_byte, active_sensor_byte);

            // Mode 0: Drive MSB before first rising clock edge
            spi_miso_i = active_sensor_byte[7];
            fork
                begin : spi_shift_loop
                    for (sbit_idx = 0; sbit_idx < 8; sbit_idx = sbit_idx + 1) begin
                        @(posedge spi_clk_o);
                        @(negedge spi_clk_o);
                        if (sbit_idx < 7) begin
                            spi_miso_i = active_sensor_byte[6 - sbit_idx];
                        end
                    end
                end
                begin : spi_cs_timeout
                    @(posedge spi_cs_n_o);
                end
            join_any
            disable fork;
        end
    end

    // -----------------------------------------------------------------------
    // Real-Time UART Serial ASCII Frame Decoder & Console Streamer
    // -----------------------------------------------------------------------
    reg [7:0] uart_char;
    integer   ubit;
    string    uart_line_buf = "";

    always begin
        @(negedge uart_tx_o);
        // Start bit: verify half-bit into frame (25 ns)
        #(UART_BIT_PERIOD / 2);
        if (uart_tx_o == 1'b0) begin
            for (ubit = 0; ubit < 8; ubit = ubit + 1) begin
                #UART_BIT_PERIOD;
                uart_char[ubit] = uart_tx_o;
            end
            #UART_BIT_PERIOD; // Stop bit
            $write("%c", uart_char);
            $fflush();
            uart_chars_decoded = uart_chars_decoded + 1;

            // Live line parser for firmware test synchronization
            if (uart_char == 8'h0A || uart_char == 8'h0D) begin
                if (uart_line_buf.len() > 0) begin
                    parse_firmware_telemetry_line(uart_line_buf);
                    uart_line_buf = "";
                end
            end else begin
                uart_line_buf = {uart_line_buf, string'(uart_char)};
            end
        end
    end

    task automatic parse_firmware_telemetry_line(input string line);
        integer tc_idx;
        // Parse [PASS] TC-xx messages from firmware
        for (tc_idx = 1; tc_idx <= 18; tc_idx = tc_idx + 1) begin
            string tag;
            $sformat(tag, "[PASS] TC-%02d", tc_idx);
            if (line.substr(0, tag.len() - 1) == tag) begin
                tc_c_status_table[tc_idx] = 2'b01; // PASS
                fw_test_id     = tc_idx;
                fw_test_state  = "PASS";
                fw_test_status = 2'b01;
            end
        end
    endtask

    // -----------------------------------------------------------------------
    // Helper Tasks: External AXI S00 Master Access
    // -----------------------------------------------------------------------
    task automatic axi_write(
        input  [31:0] addr,
        input  [31:0] data,
        input  [3:0]  strb = 4'b1111,
        output bit    ok
    );
        integer timeout;
        begin
            ok = 1'b0;
            @(negedge clk);
            axi_awaddr  = addr;
            axi_awvalid = 1'b1;
            axi_wdata   = data;
            axi_wstrb   = strb;
            axi_wlast   = 1'b1;
            axi_wvalid  = 1'b1;
            axi_bready  = 1'b1;

            timeout = 100;
            fork
                begin
                    while (!axi_awready && timeout > 0) begin
                        @(posedge clk);
                        timeout = timeout - 1;
                    end
                    @(negedge clk);
                    axi_awvalid = 1'b0;
                end
                begin
                    while (!axi_wready && timeout > 0) begin
                        @(posedge clk);
                        timeout = timeout - 1;
                    end
                    @(negedge clk);
                    axi_wvalid = 1'b0;
                end
            join

            timeout = 100;
            while (!axi_bvalid && timeout > 0) begin
                @(posedge clk);
                timeout = timeout - 1;
            end

            if (axi_bvalid && axi_bresp == 2'b00) begin
                ok = 1'b1;
            end
            @(negedge clk);
            axi_bready = 1'b0;
        end
    endtask

    task automatic axi_read(
        input  [31:0] addr,
        output [31:0] data,
        output bit    ok
    );
        integer timeout;
        begin
            ok = 1'b0;
            data = 32'h0;
            @(negedge clk);
            axi_araddr  = addr;
            axi_arvalid = 1'b1;
            axi_rready  = 1'b1;

            timeout = 100;
            while (!axi_arready && timeout > 0) begin
                @(posedge clk);
                timeout = timeout - 1;
            end
            @(negedge clk);
            axi_arvalid = 1'b0;

            timeout = 100;
            while (!axi_rvalid && timeout > 0) begin
                @(posedge clk);
                timeout = timeout - 1;
            end

            if (axi_rvalid && axi_rresp == 2'b00) begin
                data = axi_rdata;
                ok   = 1'b1;
            end
            @(negedge clk);
            axi_rready = 1'b0;
        end
    endtask

