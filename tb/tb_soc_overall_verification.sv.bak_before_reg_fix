    // TC-11: Hardware Timer Compare Match & Interrupt Generation
    task automatic run_tc11();
        bit pass, ok;
        logic [31:0] c_initial, c_adv, int_sts, int_sts_clr;
        integer timeout_cnt;
        string actual, check, evid, rem;
        mark_test_start(11, "Hardware Timer Compare Match & Interrupt Generation");
        begin
            pass = 1'b1;
            rem  = "";

            // 1. Program TIMER_LOAD = 40 (0x4000_4004)
            axi_write(32'h4000_4004, 32'd40, 4'b1111, ok);
            if (!ok) begin pass = 1'b0; rem = "AXI write to TIMER_LOAD failed"; end

            // 2. Program TIMER_CMP = 10 (0x4000_4018)
            axi_write(32'h4000_4018, 32'd10, 4'b1111, ok);
            if (!ok) begin pass = 1'b0; rem = "AXI write to TIMER_CMP failed"; end

            // 3. Program TIMER_INT_EN = 1 (0x4000_4010) - Enable expiry interrupt
            axi_write(32'h4000_4010, 32'h0000_0001, 4'b1111, ok);
            if (!ok) begin pass = 1'b0; rem = "AXI write to TIMER_INT_EN failed"; end

            // 4. Enable timer via TIMER_CTRL (0x4000_4000):
            //    bit 0 = en (1)
            //    bit 1 = mode (0 = one-shot)
            //    bit 2 = pre_en (0 = prescaler bypassed, 1 tick/cycle)
            //    bit 3 = dir (0 = down)
            //    bit 4 = pwm_en (1 = compare output enabled on timer_pwm_o)
            axi_write(32'h4000_4000, 32'h0000_0011, 4'b1111, ok);
            if (!ok) begin pass = 1'b0; rem = "AXI write to TIMER_CTRL failed"; end

            // 5. Confirm that the counter actually advances:
            axi_read(32'h4000_4008, c_initial, ok);
            repeat (5) @(posedge clk);
            axi_read(32'h4000_4008, c_adv, ok);
            $display("  [TC-11] Counter initial=0x%08h (%0d), after 5 cycles=0x%08h (%0d)", c_initial, c_initial, c_adv, c_adv);
            if (c_adv >= c_initial || c_initial == 0) begin
                pass = 1'b0;
                rem = $sformatf("Timer counter failed to advance: c_initial=%0d, c_adv=%0d", c_initial, c_adv);
            end

            // 6. Confirm that compare condition occurs:
            //    While counter > 10, timer_pwm_o is low (0).
            //    When counter <= 10, timer_pwm_o asserts high (1).
            if (pass && c_adv > 10 && timer_pwm_o !== 1'b0) begin
                pass = 1'b0;
                rem = $sformatf("timer_pwm_o asserted prematurely before compare match (counter=%0d > CMP=10)", c_adv);
            end

            timeout_cnt = 0;
            while (pass && timer_pwm_o !== 1'b1 && timeout_cnt < 200) begin
                @(posedge clk);
                timeout_cnt = timeout_cnt + 1;
            end
            if (pass && timer_pwm_o !== 1'b1) begin
                pass = 1'b0;
                rem = "Timer compare condition (timer_pwm_o at counter <= CMP=10) not detected before timeout";
            end else if (pass) begin
                $display("  [TC-11] Compare condition confirmed: timer_pwm_o asserted at %0t ps", $time);
            end

            // 7. Check that timer_irq_o asserts upon counter reaching 0 (expiration):
            timeout_cnt = 0;
            while (pass && timer_irq_o !== 1'b1 && timeout_cnt < 200) begin
                @(posedge clk);
                timeout_cnt = timeout_cnt + 1;
            end
            if (pass && timer_irq_o !== 1'b1) begin
                pass = 1'b0;
                rem = "timer_irq_o failed to assert upon counter expiration";
            end else if (pass) begin
                $display("  [TC-11] Physical timer_irq_o asserted at %0t ps", $time);
            end

            // 8. Read INT_STS and verify expected status (bit 0 == 1):
            if (pass) begin
                axi_read(32'h4000_4014, int_sts, ok);
                $display("  [TC-11] Read TIMER_INT_STS = 0x%08h (bit 0 = %0b), timer_irq_o = %0b", int_sts, int_sts[0], timer_irq_o);
                if (int_sts[0] !== 1'b1) begin
                    pass = 1'b0;
                    rem = $sformatf("TIMER_INT_STS bit 0 expected 1, observed 0 (INT_STS=0x%08h)", int_sts);
                end
            end

            // 9. Clear interrupt (W1C) and verify deassertion:
            if (pass) begin
                axi_write(32'h4000_4014, 32'h0000_0001, 4'b1111, ok);
                repeat (5) @(posedge clk);
                if (timer_irq_o !== 1'b0) begin
                    pass = 1'b0;
                    rem = "timer_irq_o failed to deassert after W1C write to INT_STS";
                end
                axi_read(32'h4000_4014, int_sts_clr, ok);
                $display("  [TC-11] Post-W1C TIMER_INT_STS = 0x%08h, timer_irq_o = %0b", int_sts_clr, timer_irq_o);
                if (int_sts_clr[0] !== 1'b0) begin
                    pass = 1'b0;
                    rem = $sformatf("TIMER_INT_STS bit 0 not cleared after W1C: 0x%08h", int_sts_clr);
                end
            end

            // 10. Record results
            if (pass) begin
                actual = "Timer loaded with 40; enabled via CTRL; counter advanced; CMP=10 match asserted timer_pwm_o; expiration asserted timer_irq_o; INT_STS[0]=1 verified; W1C cleared status and timer_irq_o";
                check  = "Timer countdown, CMP match detection, expiry interrupt generation, and W1C handshake";
                evid   = $sformatf("timer_irq_o asserted and cleared; INT_STS: 0x%08h -> 0x%08h; timer_pwm_o asserted at CMP=10; counter advanced (%0d -> %0d)", int_sts, int_sts_clr, c_initial, c_adv);
            end else begin
                actual = $sformatf("TC-11 failed: %s", rem);
                check  = "Timer countdown, CMP match detection, expiry interrupt generation, and W1C handshake";
                evid   = $sformatf("Failure: %s", rem);
            end

            tc_c_status_table[11] = pass ? 2'b01 : 2'b10;
            mark_test_end(11, pass, 1'b0, actual, check, evid, rem);
        end
    endtask

