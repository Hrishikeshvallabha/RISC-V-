                    while (!dut.s01_wready && timeout > 0) begin
                        @(posedge clk);
                        timeout = timeout - 1;
                    end
                    @(negedge clk);
                    s01_drv_wvalid = 1'b0;
                end
            join

            timeout = 100;
            while (!dut.s01_bvalid && timeout > 0) begin
                @(posedge clk);
                timeout = timeout - 1;
            end

            if (dut.s01_bvalid) begin
                bid   = dut.s01_bid;
                bresp = dut.s01_bresp;
                if (bresp == 2'b00 && bid == id) begin
                    ok = 1'b1;
                end
            end
            @(negedge clk);
            s01_drv_bready = 1'b0;
            release dut.s01_awid;
            release dut.s01_awaddr;
            release dut.s01_awlen;
