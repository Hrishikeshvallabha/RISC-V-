    // -----------------------------------------------------------------------
    // Helper Tasks: Physical UART Transmitter (Inject Bytes into SoC)
    // -----------------------------------------------------------------------
    task automatic uart_inject_byte(input [7:0] byte_val);
        integer b;
        begin
            @(negedge clk);
            uart_rx_i = 1'b1;
            #100;
            uart_rx_i = 1'b0; // Start bit
            #40;              // 4 clock cycles (matches baud_div=4 counter in uart_receiver.v)
            for (b = 0; b < 8; b = b + 1) begin
                uart_rx_i = byte_val[b];
                #40;
            end
            uart_rx_i = 1'b1; // Stop bit
            #40;
        end
    endtask

    // -----------------------------------------------------------------------
    // Helper Tasks: Real PWM Duty Cycle Measurement
    // -----------------------------------------------------------------------
    task automatic measure_pwm(
        output real    duty_pct,
        output integer period_ns,
        output integer high_ns
    );
        time t_start, t_fall, t_rise2;
        begin
            @(posedge pwm_out_o);
            t_start = $time;
            @(negedge pwm_out_o);
            t_fall  = $time;
            @(posedge pwm_out_o);
            t_rise2 = $time;

            high_ns   = (t_fall - t_start) / 1000;
            period_ns = (t_rise2 - t_start) / 1000;
            if (period_ns > 0)
                duty_pct = (real'(t_fall - t_start) / real'(t_rise2 - t_start)) * 100.0;
            else
                duty_pct = 0.0;
        end
    endtask

    // -----------------------------------------------------------------------
    // Helper Tasks: Seven-Segment Cathode Pattern to Hex Digit Decoder
    // -----------------------------------------------------------------------
    function automatic [3:0] decode_7seg(input logic [6:0] cathode_pattern);
        case (cathode_pattern)
            7'b1000000: return 4'h0;
            7'b1111001: return 4'h1;
            7'b0100100: return 4'h2;
            7'b0110000: return 4'h3;
            7'b0011001: return 4'h4;
            7'b0010010: return 4'h5;
            7'b0000010: return 4'h6;
            7'b1111000: return 4'h7;
            7'b0000000: return 4'h8;
            7'b0010000: return 4'h9;
            7'b0001000: return 4'hA;
            7'b0000011: return 4'hB;
            7'b1000110: return 4'hC;
            7'b0100001: return 4'hD;
            7'b0000110: return 4'hE;
            7'b0001110: return 4'hF;
            default:    return 4'h0;
        endcase
    endfunction

