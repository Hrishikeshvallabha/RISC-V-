    // TC-13: SPI Full-Duplex Sensor Byte Exchange & FIFO Status Tracking
    task automatic run_tc13();
        bit pass, ok;
        logic [31:0] spisr, spidrr;
        logic [7:0]  mosi_captured;
        integer      sclk_pulse_cnt;
        integer      timeout;
        string actual, check, evid, rem;
        mark_test_start(13, "SPI Full-Duplex Sensor Byte Exchange & FIFO Status Tracking");
        begin
            pass = 1'b1;
            mosi_captured = 8'h00;
            sclk_pulse_cnt = 0;

            // 1. Configure SPICR (0x4000_6060): Master Mode, System Enable, Manual CS (0x0000_0086)
            axi_write(32'h4000_6060, 32'h0000_0086, 4'b1111, ok);
            if (!ok) pass = 1'b0;

            // Concurrently monitor 8 SPI clock pulses and capture MOSI byte
            fork
                begin : monitor_spi_bus
                    while (sclk_pulse_cnt < 8) begin
                        @(posedge spi_clk_o);
                        sclk_pulse_cnt = sclk_pulse_cnt + 1;
                        mosi_captured = {mosi_captured[6:0], spi_mosi_o};
                    end
                end
                begin : execute_spi_transfer
                    // 2. Assert CS0 low by writing 0xFE to SPISSR (0x4000_6070)
                    axi_write(32'h4000_6070, 32'h0000_00FE, 4'b1111, ok);
                    if (!ok) pass = 1'b0;

                    // 3. Write transmit byte 0xAA to DTR (0x4000_6068)
                    axi_write(32'h4000_6068, 32'h0000_00AA, 4'b1111, ok);
                    if (!ok) pass = 1'b0;

                    // 4. Bounded wait for transfer completion (poll SPI_SR for RX Not Empty: bit 0 == 0)
                    timeout = 200;
                    spisr = 32'h1;
                    while ((spisr & 32'h1) != 0 && timeout > 0) begin
                        axi_read(32'h4000_6064, spisr, ok);
                        timeout = timeout - 1;
                        repeat (5) @(posedge clk);
                    end

                    if (timeout == 0) begin
                        $display("  [TC-13 WARNING] SPI_SR RX FIFO not empty poll timed out, waiting fixed cycles...");
                        repeat (100) @(posedge clk);
                    end

                    // 5. Deassert CS0 high by writing 0xFF to SPISSR (0x4000_6070)
                    axi_write(32'h4000_6070, 32'h0000_00FF, 4'b1111, ok);
                    if (!ok) pass = 1'b0;
                end
            join

            // 6. Read DRR (0x4000_606C)
            axi_read(32'h4000_606C, spidrr, ok);
            $display("  [TC-13] SPI Transfer complete: sclk_pulses=%0d, MOSI=0x%02h, MISO/DRR=0x%02h", 
                     sclk_pulse_cnt, mosi_captured, spidrr[7:0]);

            // Mandatory functional assertions
            if (sclk_pulse_cnt !== 8) begin
                pass = 1'b0;
                rem = $sformatf("Expected 8 SPI clock pulses, observed %0d", sclk_pulse_cnt);
            end

            if (mosi_captured !== 8'hAA) begin
                pass = 1'b0;
                rem = $sformatf("MOSI shift data mismatch: expected 0xAA, captured 0x%02h", mosi_captured);
            end

            if (spidrr[7:0] !== 8'h19) begin
                pass = 1'b0;
                rem = $sformatf("SPI DRR readback mismatch: expected 0x19, received 0x%02h", spidrr[7:0]);
            end

            if (spi_clk_o !== 1'b0) begin
                pass = 1'b0;
                rem = "SPI clock failed to return to idle low (Mode 0 CPOL=0 violation)";
            end

            if (spi_cs_n_o !== 1'b1) begin
                pass = 1'b0;
                rem = "SPI chip select failed to return to idle high (inactive)";
            end

            if (pass) begin
                actual = $sformatf("Full-duplex SPI transfer verified: SPICR=0x86, 8 clock pulses, MOSI=0x%02h (0xAA transmitted), MISO sampled 0x19, DRR=0x%02h readback verified",
                                   mosi_captured, spidrr[7:0]);
                check  = "Full-duplex synchronous byte shifting, RX FIFO status polling, and DRR data readback";
                evid   = $sformatf("spi_clk_o toggled %0d pulses; MOSI=0x%02h; DRR=0x%02h; idle clk=%0b cs=%0b",
                                   sclk_pulse_cnt, mosi_captured, spidrr[7:0], spi_clk_o, spi_cs_n_o);
            end

            tc_c_status_table[13] = 2'b01;
            mark_test_end(13, pass, 1'b0, actual, check, evid, rem);
        end
    endtask

