            if (remarks != "") $display("  Remarks : %s", remarks);
        end else if (pass) begin
            test_status                = 2'b01; // PASS
            test_state                 = "PASS";
            fw_test_status             = 2'b01;
            overall_test_state         = "PASS";
            tc_sv_status_table[id]     = 2'b01;
            tc_overall_status_table[id]= 2'b01;
            test_pass_count            = test_pass_count + 1;
            $display("[PASS] TC-%02d: %s (Time: %0t ps -> %0t ps, Duration: %0t ps)", 
                     id, tc_name_table[id], test_start_time, test_end_time, (test_end_time - test_start_time));
            $display("  Actual Observed: %s", actual_val);
            $display("  Functional Chk : %s", check_desc);
            $display("  Evidence       : %s", evidence);
        end else begin
            test_status                = 2'b10; // FAIL
            test_state                 = "FAIL";
            fw_test_status             = 2'b10;
            overall_test_state         = "FAIL";
            tc_sv_status_table[id]     = 2'b10;
            tc_overall_status_table[id]= 2'b10;
            test_fail_count            = test_fail_count + 1;
            $display("[FAIL] TC-%02d: %s (Time: %0t ps -> %0t ps)", id, tc_name_table[id], test_start_time, test_end_time);
            $display("  Actual Observed: %s", actual_val);
            $display("  Failure Detail : %s", remarks);
        end

        @(posedge clk);
        test_done_marker = 1'b0;
        fw_done_marker   = 1'b0;
        $display("-------------------------------------------------------------------------");
    endtask

