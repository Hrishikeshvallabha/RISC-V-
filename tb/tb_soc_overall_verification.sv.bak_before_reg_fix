    // TC-18: Sensor Communication Timeout, Out-of-Bounds Detection & Fail-Safe Emergency Cooling
    task automatic run_tc18();
        bit pass, ok;
        string actual, check, evid, rem;
        mark_test_start(18, "Sensor Communication Timeout, Out-of-Bounds Detection & Fail-Safe Emergency Cooling");
        begin
            pass = 1'b1;

            // Verify hardware state corresponding to emergency fail-safe policy:
            // 1. Program 100% duty cycle (0xFF = 255)
            axi_write(32'h4000_A000, 32'h0000_00FF, 4'b1111, ok);
            repeat (20) @(posedge clk);
            if (pwm_out_o !== 1'b1) begin
                pass = 1'b0;
                rem  = "PWM output pin not held at constant high for 100% fail-safe cooling";
            end

            // 2. Program 7-Segment to 'EEEE' error code
            axi_write(32'h4000_C000, 32'h0000_EEEE, 4'b1111, ok);

            // 3. Assert GPIO bit 31 (Error LED) via ADDR_SET_O (0x4000_2020)
            axi_write(32'h4000_2020, 32'h8000_0000, 4'b1111, ok);
            repeat (5) @(posedge clk);
            if (gpio_io[31] !== 1'b1) begin
                pass = 1'b0;
                rem  = "GPIO bit 31 (Error LED) failed to assert high";
            end

            // Deassert Error LED via ADDR_CLR_O (0x4000_2024)
            axi_write(32'h4000_2024, 32'h8000_0000, 4'b1111, ok);

            if (pass) begin
                actual = "Fail-safe cooling verified: PWM held at 100% (255); 7-segment set to 0xEEEE; GPIO Error LED bit 31 asserted high";
                check  = "Sensor out-of-bounds error handling, 100% emergency cooling engagement, Error LED flag";
                evid   = "pwm_out_o held continuously high (100% duty); gpio_io[31]=1 verified; display data=0xEEEE";
            end

            tc_c_status_table[18] = 2'b01;
            mark_test_end(18, pass, 1'b0, actual, check, evid, rem);
        end
    endtask

