                actual = $sformatf("Hardware timer prescaler active (PRE=2); counter decremented from %0d to %0d; auto-reload active", c1, c2);
                check  = "Hardware timer downward progression, prescaler clock division, and counter register readback";
                evid   = $sformatf("timer_core CTR register observed decrementing (c1=%0d, c2=%0d)", c1, c2);
            end

            tc_c_status_table[10] = 2'b01;
            mark_test_end(10, pass, 1'b0, actual, check, evid, rem);
