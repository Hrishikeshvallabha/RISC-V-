            force dut.s01_awlen    = 8'd0;
            force dut.s01_awsize   = 3'b010;
            force dut.s01_awburst  = 2'b01;
            force dut.s01_awlock   = 1'b0;
            force dut.s01_awcache  = 4'b0000;
            force dut.s01_awprot   = 3'b000;
            force dut.s01_awqos    = 4'b0000;
            force dut.s01_awregion = 4'b0000;
            force dut.s01_awvalid  = s01_drv_awvalid;

            force dut.s01_wdata    = s01_drv_wdata;
            force dut.s01_wstrb    = s01_drv_wstrb;
            force dut.s01_wlast    = 1'b1;
            force dut.s01_wvalid   = s01_drv_wvalid;
            force dut.s01_bready   = s01_drv_bready;

            timeout = 100;
