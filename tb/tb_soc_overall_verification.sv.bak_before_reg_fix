    // -----------------------------------------------------------------------
    task automatic s01_axi_write(
        input  [7:0]  id,
        input  [31:0] addr,
        input  [31:0] data,
        input  [3:0]  strb,
        output [7:0]  bid,
        output [1:0]  bresp,
